{
  "name": "ghost-comments",
  "displayName": "Ghost Comments",
  "description": "Attach durable, repository-shared notes to code.",
  "version": "0.0.2",
  "publisher": "ghost-comments",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.gc/notes.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghostComments.createNote",
        "title": "Create Note",
        "category": "Ghost Comments"
      },
      {
        "command": "ghostComments.submitNote",
        "title": "Save Note",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "ghostComments.cancelNote",
        "title": "Cancel"
      },
      {
        "command": "ghostComments.editNote",
        "title": "Edit Note",
        "icon": "$(edit)"
      },
      {
        "command": "ghostComments.saveNote",
        "title": "Save"
      },
      {
        "command": "ghostComments.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "ghostComments.deleteNote",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "ghostComments.reattachNote",
        "title": "Reattach Note"
      }
    ],
    "keybindings": [
      {
        "command": "ghostComments.createNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ghostComments.submitNote",
          "when": "false"
        },
        {
          "command": "ghostComments.cancelNote",
          "when": "false"
        },
        {
          "command": "ghostComments.editNote",
          "when": "false"
        },
        {
          "command": "ghostComments.saveNote",
          "when": "false"
        },
        {
          "command": "ghostComments.cancelEdit",
          "when": "false"
        },
        {
          "command": "ghostComments.deleteNote",
          "when": "false"
        },
        {
          "command": "ghostComments.reattachNote",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ghostComments.submitNote",
          "group": "inline@2",
          "when": "commentController == ghostComments && commentThreadIsEmpty"
        },
        {
          "command": "ghostComments.cancelNote",
          "group": "inline@1",
          "when": "commentController == ghostComments && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ghostComments.reattachNote",
          "group": "navigation",
          "when": "commentController == ghostComments && commentThread == stale"
        }
      ],
      "comments/comment/title": [
        {
          "command": "ghostComments.editNote",
          "group": "navigation@1",
          "when": "commentController == ghostComments"
        },
        {
          "command": "ghostComments.deleteNote",
          "group": "navigation@2",
          "when": "commentController == ghostComments"
        }
      ],
      "comments/comment/context": [
        {
          "command": "ghostComments.cancelEdit",
          "group": "inline@1",
          "when": "commentController == ghostComments"
        },
        {
          "command": "ghostComments.saveNote",
          "group": "inline@2",
          "when": "commentController == ghostComments"
        }
      ]
    },
    "configuration": {
      "title": "Ghost Comments",
      "properties": {
        "ghostComments.authorName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Display name stored with newly created notes."
        }
      }
    }
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "tsc && node --test out/test/*.test.js",
    "test:integration": "tsc && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run check && npm run build",
    "sandbox": "npm run build && node scripts/sandbox.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}

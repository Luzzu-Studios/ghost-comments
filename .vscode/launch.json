{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ghost Threads (Sandbox)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "preLaunchTask": "npm: build",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "args": [
        "${workspaceFolder}/test/fixtures/workspace",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ]
    }
  ]
}
